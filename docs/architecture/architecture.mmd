flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Clients["Clients"]
        direction TB
        App(["Instrumented LLM app"]):::edge
        Tracer["Tracer and spans<br/>@instrument, samplers"]:::core
        Engineer(["Engineer in browser"]):::edge
        Pages["Preact dashboard<br/>TypeScript, /ui"]:::core
        ApiClient["api.ts client<br/>response shape checks"]:::control
        App --> Tracer ~~~ Engineer --> Pages --> ApiClient
    end

    subgraph Service["Collector service"]
        direction TB
        Cli(["CLI<br/>serve, sample-traces"]):::edge
        Router["HTTP router<br/>/api/traces, /summary"]:::core
        Validate["Validation<br/>batch limits, filters"]:::control
        Analysis["Analysis<br/>cost, tokens, p50 to p99"]:::core
        Cli --> Router --> Validate --> Analysis
    end

    subgraph State["Data and state"]
        direction TB
        Store[("TraceStore<br/>bounded, in memory")]:::data
        Prices[("PriceList<br/>USD per 1M tokens")]:::data
        Store ~~~ Prices
    end

    subgraph Obs["Observability and outputs"]
        direction TB
        Views["JSON views<br/>list, detail, summary"]:::obs
        Slo["SLO evaluation<br/>latency objective"]:::obs
        Export["Exporters<br/>JSON, Chrome, CSV"]:::obs
        Metrics["/metrics<br/>Prometheus text"]:::obs
        Views ~~~ Slo ~~~ Export ~~~ Metrics
    end

    Clients -->|trace JSON, fetch /api| Service
    Service -->|ingest| State
    State -.->|traces, prices| Service
    Service -->|summaries, timings| Obs
