---
title: System Architecture - LLM Observability
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#E2E8F0"
    clusterBorder: "#94A3B8"
---
flowchart LR
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef external fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    App([Instrumented app]):::external

    subgraph Tracing["Tracing"]
        Tracer[Tracer]:::core
        Span[Spans]:::core
        Trace[Trace tree]:::core
    end

    subgraph Processing["Processing"]
        Cost[Cost model]:::core
        Metrics[Metrics aggregation]:::core
        Analysis[Batch analysis]:::core
    end

    subgraph Output["Output"]
        Tree[Waterfall tree]:::core
        Json[(JSON export)]:::data
    end

    App -->|with span| Tracer
    Tracer --> Span
    Span --> Trace
    Trace --> Metrics
    Cost --> Metrics
    Trace --> Tree
    Trace --> Json
    Metrics --> Analysis
    Analysis -.->|regression alerts| App
